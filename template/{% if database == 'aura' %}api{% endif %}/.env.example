# Local development config. Copy to api/.env (gitignored). The defaults match
# the Neo4j started by `docker compose up` at the repository root.
#
# Never point NEO4J_URI at Aura (*.databases.neo4j.io) from a dev machine.
# Production credentials are written to the host by Loftline and live nowhere
# else.
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=localdev

# Browser origins allowed to call the API, comma separated. Only a web
# front-end needs this; the Vite dev server is allowed here for local work.
CORS_ORIGINS=http://localhost:5173

# Any long random string. Loftline generates the real one per project.
JWT_SECRET=dev-only-not-a-secret-dev-only-not-a-secret

# SMTP for password reset codes. Leave both blank locally: nothing is sent and
# /forgot-password logs the code to the console instead, which is enough to
# walk the whole flow. For Gmail, SMTP_PASSWORD is an app password, never the
# account password.
SMTP_USER=
SMTP_PASSWORD=
