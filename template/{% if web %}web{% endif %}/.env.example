# Where the site finds the API during development. Copy to web/.env
# (gitignored). Vite bakes VITE_* variables into the bundle at build time, so
# a hosted build gets its value from the host's environment, never from here.
#
# The API must list the site's origin in CORS_ORIGINS; the docker compose
# file and api/.env.example already allow http://localhost:5173, the Vite
# dev server's address.
VITE_API_URL=http://127.0.0.1:8000
