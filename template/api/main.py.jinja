import importlib
import logging
import pkgutil
from contextlib import asynccontextmanager

from dotenv import load_dotenv

load_dotenv()

from fastapi import FastAPI

import db
import routers

logger = logging.getLogger("app.main")

# How long to wait for the database at boot before giving up. Under docker
# compose the API container can win the race against the database's own
# startup even with a health check in front of it; on a hosted platform a
# deploy that boots before the database is reachable should fail loudly rather
# than serve 500s.
DB_WAIT_SECONDS = 60


def _include_routers(app: FastAPI) -> None:
    """Include every router in the routers package, in name order.

    Optional features add endpoints by adding a module to `routers/`. This
    function never changes for them, which is what keeps a feature a
    conditional path rather than a conditional block in a shared file.
    """
    for info in sorted(pkgutil.iter_modules(routers.__path__), key=lambda m: m.name):
        module = importlib.import_module(f"routers.{info.name}")
        router = getattr(module, "router", None)
        if router is None:
            raise RuntimeError(f"routers/{info.name}.py defines no `router`")
        app.include_router(router)


@asynccontextmanager
async def lifespan(app: FastAPI):
    # This file is the same whichever database the project uses. The database
    # module is the branch: it provides these four calls and get_session, and
    # nothing else here knows which store is behind them.
    db.wait_until_reachable(DB_WAIT_SECONDS)
    db.migrate()
    yield
    db.close()


app = FastAPI(title="{{ project_name }} API", lifespan=lifespan)
_include_routers(app)


@app.get("/health")
def health():
    try:
        db.ping()
        return {"ok": True, "db": True}
    except Exception:
        return {"ok": True, "db": False}
