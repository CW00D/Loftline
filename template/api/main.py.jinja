import importlib
import logging
import pkgutil
import time
from contextlib import asynccontextmanager

from dotenv import load_dotenv

load_dotenv()

from fastapi import FastAPI
from neo4j.exceptions import ServiceUnavailable

import db
import routers
from schema import ensure_schema

logger = logging.getLogger("app.main")

# How long to wait for the database at boot before giving up. Under docker
# compose the API container can win the race against Neo4j's own startup even
# with a health check in front of it; on a hosted platform a deploy that boots
# before the database is reachable should fail loudly rather than serve 500s.
DB_WAIT_SECONDS = 60


def _wait_for_database() -> None:
    deadline = time.monotonic() + DB_WAIT_SECONDS
    while True:
        try:
            with db.get_session() as session:
                session.run("RETURN 1").consume()
            return
        except ServiceUnavailable:
            if time.monotonic() >= deadline:
                raise
            logger.warning("database not reachable yet; retrying")
            time.sleep(2)


def _include_routers(app: FastAPI) -> None:
    """Include every router in the routers package, in name order.

    Optional features add endpoints by adding a module to `routers/`. This
    function never changes for them, which is what keeps a feature a
    conditional path rather than a conditional block in a shared file.
    """
    for info in sorted(pkgutil.iter_modules(routers.__path__), key=lambda m: m.name):
        module = importlib.import_module(f"routers.{info.name}")
        router = getattr(module, "router", None)
        if router is None:
            raise RuntimeError(f"routers/{info.name}.py defines no `router`")
        app.include_router(router)


@asynccontextmanager
async def lifespan(app: FastAPI):
    _wait_for_database()
    with db.get_session() as session:
        # Idempotent; this is the migration step. See schema.py.
        ensure_schema(session)
    yield
    db.close_driver()


app = FastAPI(title="{{ project_name }} API", lifespan=lifespan)
_include_routers(app)


@app.get("/health")
def health():
    # Touches the graph so an external uptime ping also counts as database
    # activity: free Aura instances pause after three idle days.
    try:
        with db.get_session() as session:
            session.run("RETURN 1").consume()
        return {"ok": True, "db": True}
    except Exception:
        return {"ok": True, "db": False}
