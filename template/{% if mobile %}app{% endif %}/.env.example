# Where the app finds the API during development. Copy to app/.env (gitignored).
#
# A phone cannot reach 127.0.0.1 on your laptop. Use the laptop's LAN address
# (ipconfig on Windows, ifconfig elsewhere), with the phone on the same wifi,
# and allow inbound port 8000 through the firewall the first time.
#
# Hosted builds do not read this file; eas.json sets the URL per profile.
EXPO_PUBLIC_API_URL=http://192.168.1.42:8000
