# Local development config. Copy to api/.env (gitignored). The default matches
# the Postgres started by `docker compose up` at the repository root.
#
# Never point DATABASE_URL at a hosted database from a dev machine. Production
# credentials are written to the host by Loftline and live nowhere else; the
# seed and the tests refuse anything that is not local anyway.
DATABASE_URL=postgresql://app:localdev@127.0.0.1:5432/app
# If a Postgres is already installed on this machine it owns port 5432 and
# will answer instead of the container. Change the host port in
# docker-compose.yml (say 5433:5432) and here to match.

# Browser origins allowed to call the API, comma separated. Only a web
# front-end needs this; the Vite dev server is allowed here for local work.
CORS_ORIGINS=http://localhost:5173

# Any long random string. Loftline generates the real one per project.
JWT_SECRET=dev-only-not-a-secret-dev-only-not-a-secret

# SMTP for password reset codes. Leave both blank locally: nothing is sent and
# /forgot-password logs the code to the console instead, which is enough to
# walk the whole flow. For Gmail, SMTP_PASSWORD is an app password, never the
# account password.
SMTP_USER=
SMTP_PASSWORD=
