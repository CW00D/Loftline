# Builds the iOS and Android release candidates whenever the app changes on
# staging.
#
# ADR-013: for a mobile project the staging branch produces the builds that
# are submitted to the stores, and submission itself stays manual. This
# workflow builds; it does not submit. From a laptop, once the builds are
# done: `eas submit --platform ios --profile preview` and
# `eas submit --platform android --profile preview`, the latter with the
# Google Play service account key at app/google-play-service-account.json
# (descriptor: google_play_service_account; never committed).
#
# Copied into generated projects byte for byte, never rendered. ${{ }} is
# GitHub's syntax. Needs one repository secret, written by Loftline:
#   EXPO_TOKEN   an Expo access token (descriptor: expo_access_token)
# Apple signing credentials and the Android keystore are configured once
# through `eas credentials` and held by EAS, not by this workflow.
name: EAS build (staging)

on:
  push:
    branches: [staging]
    paths: ["app/**"]
  workflow_dispatch:

concurrency:
  group: eas-build-staging
  cancel-in-progress: false

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    defaults:
      run:
        working-directory: app

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Node
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Install dependencies
        run: npm install --no-audit --no-fund

      - name: Install EAS CLI
        run: npm install -g eas-cli

      - name: Build the iOS release candidate
        run: eas build --platform ios --profile preview --non-interactive --no-wait
        env:
          EXPO_TOKEN: ${{ secrets.EXPO_TOKEN }}

      - name: Build the Android release candidate
        run: eas build --platform android --profile preview --non-interactive --no-wait
        env:
          EXPO_TOKEN: ${{ secrets.EXPO_TOKEN }}
