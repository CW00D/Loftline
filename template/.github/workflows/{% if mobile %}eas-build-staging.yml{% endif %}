# Builds the iOS release candidate whenever the app changes on staging.
#
# ADR-013: for a mobile project the staging branch produces the build that is
# submitted to the stores, and submission itself stays manual. This workflow
# builds; it does not submit. Store submission is Step 9 of the roadmap.
#
# Copied into generated projects byte for byte, never rendered. ${{ }} is
# GitHub's syntax. Needs one repository secret, written by Loftline:
#   EXPO_TOKEN   an Expo access token (descriptor: expo_access_token)
# Apple signing credentials are configured once through `eas credentials`
# and held by EAS, not by this workflow.
name: EAS build (staging)

on:
  push:
    branches: [staging]
    paths: ["app/**"]
  workflow_dispatch:

concurrency:
  group: eas-build-staging
  cancel-in-progress: false

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    defaults:
      run:
        working-directory: app

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Node
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Install dependencies
        run: npm install --no-audit --no-fund

      - name: Install EAS CLI
        run: npm install -g eas-cli

      - name: Build the iOS release candidate
        run: eas build --platform ios --profile preview --non-interactive --no-wait
        env:
          EXPO_TOKEN: ${{ secrets.EXPO_TOKEN }}
